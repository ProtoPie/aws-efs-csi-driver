// Helper methods

func (suite *IntegrationTestSuite) setupSuccessfulRollbackMocks() {
	// Mock mount target deletions
	suite.mockEFSClient.EXPECT().
		DeleteMountTarget(gomock.Any(), &efs.DeleteMountTargetInput{
			MountTargetId: aws.String("fsmt-11111"),
		}).
		Return(&efs.DeleteMountTargetOutput{}, nil).
		MaxTimes(6) // Account for retries

	suite.mockEFSClient.EXPECT().
		DeleteMountTarget(gomock.Any(), &efs.DeleteMountTargetInput{
			MountTargetId: aws.String("fsmt-22222"),
		}).
		Return(&efs.DeleteMountTargetOutput{}, nil).
		MaxTimes(6) // Account for retries

	// Mock mount target status checks (simulate deletion completion)
	suite.mockEFSClient.EXPECT().
		DescribeMountTargets(gomock.Any(), &efs.DescribeMountTargetsInput{
			MountTargetId: aws.String("fsmt-11111"),
		}).
		Return(nil, errors.New("MountTargetNotFound")).
		AnyTimes()

	suite.mockEFSClient.EXPECT().
		DescribeMountTargets(gomock.Any(), &efs.DescribeMountTargetsInput{
			MountTargetId: aws.String("fsmt-22222"),
		}).
		Return(nil, errors.New("MountTargetNotFound")).
		AnyTimes()

	// Mock security group deletion
	suite.mockEC2Client.EXPECT().
		DeleteSecurityGroup(gomock.Any(), &ec2.DeleteSecurityGroupInput{
			GroupId: aws.String("sg-12345"),
		}).
		Return(&ec2.DeleteSecurityGroupOutput{}, nil).
		MaxTimes(6) // Account for retries

	// Mock filesystem deletion
	suite.mockEFSClient.EXPECT().
		DeleteFileSystem(gomock.Any(), &efs.DeleteFileSystemInput{
			FileSystemId: aws.String("fs-12345"),
		}).
		Return(&efs.DeleteFileSystemOutput{}, nil).
		MaxTimes(6) // Account for retries

	// Mock cache deletion
	suite.mockCache.EXPECT().
		Delete(suite.namespace)
}

// Run the integration test suite
func TestIntegrationSuite(t *testing.T) {
	suite.Run(t, new(IntegrationTestSuite))
}

// Stress test for error handling under high load
func TestStressErrorHandling(t *testing.T) {
	if testing.Short() {
		t.Skip("Skipping stress test in short mode")
	}

	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	const numWorkers = 50
	const operationsPerWorker = 100

	var wg sync.WaitGroup
	errors := make(chan error, numWorkers*operationsPerWorker)

	for i := 0; i < numWorkers; i++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()

			for j := 0; j < operationsPerWorker; j++ {
				// Test retry mechanism under load
				err := RetryableAWSOperation(ctx, nil, "StressTest", fmt.Sprintf("worker-%d", workerID), func() error {
					// Simulate varying success rates
					if j%10 == 0 {
						return errors.New("simulated failure")
					}
					return nil
				})

				if err != nil {
					errors <- fmt.Errorf("worker %d, operation %d: %w", workerID, j, err)
				}
			}
		}(i)
	}

	wg.Wait()
	close(errors)

	// Count errors
	errorCount := 0
	for err := range errors {
		t.Logf("Stress test error: %v", err)
		errorCount++
	}

	// Allow for some failures under stress, but not too many
	maxAllowedErrors := numWorkers * operationsPerWorker / 20 // Allow up to 5% failure rate
	assert.LessOrEqual(t, errorCount, maxAllowedErrors,
		"Too many errors under stress: %d/%d", errorCount, numWorkers*operationsPerWorker)
}

// Test memory usage during error handling
func TestMemoryUsageUnderErrorConditions(t *testing.T) {
	if testing.Short() {
		t.Skip("Skipping memory test in short mode")
	}

	ctx := context.Background()
	
	// Test that repeated error handling doesn't cause memory leaks
	for i := 0; i < 1000; i++ {
		err := RetryableAWSOperation(ctx, nil, "MemoryTest", "test-namespace", func() error {
			if i%2 == 0 {
				return NewEFSNSError(ErrAWSThrottled, "test", "test-ns", "throttled", nil)
			}
			return nil
		})
		
		// Some operations should succeed, some should fail after retries
		if i%2 == 0 {
			assert.Error(t, err) // Should fail after retries
		} else {
			assert.NoError(t, err) // Should succeed immediately
		}
	}
}