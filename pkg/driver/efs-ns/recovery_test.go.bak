func TestPartialFileSystemInfo(t *testing.T) {
	info := &PartialFileSystemInfo{
		FileSystemID:    "fs-12345",
		Namespace:       "test-namespace",
		MountTargetIDs:  []string{"fsmt-11111", "fsmt-22222"},
		SecurityGroupID: "sg-12345",
		CreatedAt:       time.Now(),
		State:           "creating",
	}

	assert.Equal(t, "fs-12345", info.FileSystemID)
	assert.Equal(t, "test-namespace", info.Namespace)
	assert.Len(t, info.MountTargetIDs, 2)
	assert.Equal(t, "sg-12345", info.SecurityGroupID)
	assert.Equal(t, "creating", info.State)
}

func TestRecoveryManager_TrackOperation(t *testing.T) {
	rm := &recoveryManager{
		operations: make(map[string]*RecoveryOperation),
	}

	operation := &RecoveryOperation{
		ID:        "test-op",
		Type:      RecoveryOperationRollback,
		Namespace: "test-namespace",
		Status:    RecoveryOperationStatusPending,
	}

	rm.trackOperation(operation)

	// Verify operation is tracked
	rm.operationsMu.RLock()
	trackedOp, exists := rm.operations["test-op"]
	rm.operationsMu.RUnlock()

	assert.True(t, exists)
	assert.Equal(t, operation, trackedOp)
}

func TestRecoveryManager_CompleteOperation(t *testing.T) {
	rm := &recoveryManager{
		operations: make(map[string]*RecoveryOperation),
	}

	operation := &RecoveryOperation{
		ID:     "test-op",
		Status: RecoveryOperationStatusRunning,
	}

	rm.operations["test-op"] = operation
	rm.completeOperation("test-op")

	// Verify operation is marked as completed
	assert.Equal(t, RecoveryOperationStatusCompleted, operation.Status)
}

func TestRecoveryManager_Constants(t *testing.T) {
	assert.Equal(t, 10*time.Minute, RecoveryCleanupTimeout)
	assert.Equal(t, 24*time.Hour, OrphanedResourceMaxAge)
	assert.Equal(t, 5*time.Minute, RecoveryOperationTimeout)
}

// Integration-style test for recovery manager lifecycle
func TestRecoveryManager_Integration(t *testing.T) {

	mockEFSClient := NewMockEFSClient()
	mockEC2Client := NewMockEC2Client()
	mockCache := NewMockRecoveryCache()
	mockTracker := NewMockPVCTracker()

	rm := NewRecoveryManager(
		mockEFSClient,
		mockEC2Client,
		mockCache,
		mockTracker,
		"test-cluster",
		"vpc-12345",
	)

	ctx := context.Background()

	// Test that we can create the recovery manager and it has the right interface
	assert.NotNil(t, rm)

	// Test that cleanup operations don't panic with empty state
	err := rm.CleanupOrphanedResources(ctx)
	assert.NoError(t, err) // Should not error with empty state

	// Test validation with empty cache
	mockCache.EXPECT().List().Return(map[string]*FileSystemInfo{})
	err = rm.ValidateResourceConsistency(ctx)
	assert.NoError(t, err)
}

// Benchmark tests for recovery operations
func BenchmarkRecoveryManager_TrackOperation(b *testing.B) {
	rm := &recoveryManager{
		operations: make(map[string]*RecoveryOperation),
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		operation := &RecoveryOperation{
			ID:        string(rune(i)),
			Type:      RecoveryOperationRollback,
			Namespace: "test-namespace",
			Status:    RecoveryOperationStatusPending,
		}
		rm.trackOperation(operation)
	}
}

func BenchmarkRecoveryManager_CompleteOperation(b *testing.B) {
	rm := &recoveryManager{
		operations: make(map[string]*RecoveryOperation),
	}

	// Pre-populate operations
	for i := 0; i < b.N; i++ {
		operation := &RecoveryOperation{
			ID:     string(rune(i)),
			Status: RecoveryOperationStatusRunning,
		}
		rm.operations[string(rune(i))] = operation
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		rm.completeOperation(string(rune(i)))
	}
}